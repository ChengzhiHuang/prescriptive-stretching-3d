  "painPrograms": [
    {
      "chinese": "醒来时会头痛吗？",
      "english": "Do you wake up with a headache?",
      "category": "waking",
      "printedPage": "119",
      "tip": "常见于夜间紧咬牙关或耸肩入睡；睡前放松肩颈并核对床垫与枕头支撑。",
      "recommendedStretches": [
        "upper-trapezius",
        "suboccipitals",
        "sternocleidomastoid"
      ]
    },
    {
      "chinese": "醒来时脖子会发僵吗？",
      "english": "Do you wake up with a stiff neck?",
      "category": "waking",
      "printedPage": "119",
      "tip": "多因侧卧枕头过高使颈侧一拉一缩；调整枕高让头颈与脊柱保持同一直线。",
      "recommendedStretches": [
        "levator-scapulae-1",
        "upper-trapezius",
        "scalenes"
      ]
    },
    {
      "chinese": "醒来时手臂会发麻吗？",
      "english": "Are your arms asleep when you wake up?",
      "category": "waking",
      "printedPage": "120",
      "tip": "多因仰卧双臂举过头顶压迫神经血管束；改为手臂放身体两侧，每晚睡前拉伸胸肌。",
      "recommendedStretches": [
        "pectoralis-major-1",
        "pectoralis-minor-standing"
      ]
    },
    {
      "chinese": "醒来时肩膀会痛吗？",
      "english": "Does your shoulder hurt when you wake up?",
      "category": "waking",
      "printedPage": "120",
      "tip": "多因手臂压在枕头下方使肘高过头挤压冈上肌；改为仰卧或让手臂低于肩部入睡。",
      "recommendedStretches": [
        "supraspinatus-1",
        "infraspinatus-1"
      ]
    },
    {
      "chinese": "醒来时腰背会痛吗？",
      "english": "Does your lower back hurt when you wake up?",
      "category": "waking",
      "printedPage": "120",
      "tip": "多因趴在过软床垫上导致腰椎反弓，叠加髋屈肌紧绷；睡前拉伸髋屈肌并改为侧卧。",
      "recommendedStretches": [
        "psoas-iliacus",
        "piriformis-seated"
      ]
    },
